generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DocumentType {
  AADHAAR
  PAN
  DRIVING_LICENSE
  PASSPORT
  VOTER_ID
  INSURANCE_HEALTH
  INSURANCE_VEHICLE
  INSURANCE_LIFE
  ITR
  BANK_STATEMENT
  UTILITY_BILL
  EDUCATION_CERTIFICATE
  BIRTH_CERTIFICATE
  OTHER
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  vaultKeySalt String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  persons      Person[]
  documents    Document[]
  tags         Tag[]
  reminders    Reminder[]
}

model Person {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  relation  String?
  dob       DateTime?
  documents Document[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
}

model Document {
  id           String            @id @default(cuid())
  userId       String
  personId     String
  type         DocumentType
  title        String
  metadataEnc  String            @default("{}")
  isFavorite   Boolean           @default(false)
  inTravelPack Boolean           @default(false)
  expiryDate   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  person       Person            @relation(fields: [personId], references: [id], onDelete: Cascade)
  tags         DocumentTag[]
  versions     DocumentVersion[]
  reminders    Reminder[]

  @@index([userId, personId, type])
  @@index([expiryDate])
  @@index([userId, isFavorite])
  @@index([userId, inTravelPack])
}

model DocumentVersion {
  id         String   @id @default(cuid())
  documentId String
  year       Int
  fileKey    String
  fileName   String
  mimeType   String
  sizeBytes  Int
  ocrTextEnc String?
  checksum   String
  uploadedAt DateTime @default(now())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, year])
  @@index([documentId])
}

model Tag {
  id     String        @id @default(cuid())
  userId String
  name   String
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  docs   DocumentTag[]

  @@unique([userId, name])
}

model DocumentTag {
  documentId String
  tagId      String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([documentId, tagId])
}

model Reminder {
  id         String   @id @default(cuid())
  userId     String
  documentId String
  remindAt   DateTime
  daysBefore Int
  sent       Boolean  @default(false)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([remindAt, sent])
  @@index([userId])
}

# Database
DATABASE_URL=postgresql://docvault:docvault@localhost:5432/docvault

# Auth
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Encryption at rest (32-byte key, base64-encoded)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VAULT_MASTER_KEY=

# API
API_PORT=4000
STORAGE_PATH=./uploads
CORS_ORIGIN=http://localhost:3000

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000

# Mobile (Expo) — use your LAN IP for physical device testing
EXPO_PUBLIC_API_URL=http://localhost:4000

# Reminders (days before expiry to notify)
REMINDER_DAYS_BEFORE=30,7,1
